graph G { rankdir=LR; bgcolor=white;
node [fontname="DejaVu Sans",fontsize=12,fontcolor=black,color=black];
edge [color=black];
a [shape=plaintext,label="Người dùng"];
subgraph cluster_system { label="StayHub"; color=black;
u10 [shape=ellipse,label="UC10 — Xem chuyến đi của tôi"];
u11 [shape=ellipse,label="UC11 — Xem chi tiết đơn"];
u12 [shape=ellipse,label="UC12 — Hủy đơn đặt phòng"];
u13 [shape=ellipse,label="UC13 — Viết đánh giá"];
}
a -- u10;
a -- u11;
a -- u12;
a -- u13;
}