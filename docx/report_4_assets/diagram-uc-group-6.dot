graph G { rankdir=LR; bgcolor=white;
node [fontname="DejaVu Sans",fontsize=12,fontcolor=black,color=black];
edge [color=black];
a [shape=plaintext,label="Host"];
subgraph cluster_system { label="StayHub"; color=black;
u16 [shape=ellipse,label="UC16 — Theo dõi đơn của Host"];
u17 [shape=ellipse,label="UC17 — Chấp nhận yêu cầu đặt\nphòng (mở rộng)"];
