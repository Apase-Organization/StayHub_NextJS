graph G { rankdir=LR; bgcolor=white;
node [fontname="DejaVu Sans",fontsize=12,fontcolor=black,color=black];
edge [color=black];
a [shape=plaintext,label="Người dùng"];
subgraph cluster_system { label="StayHub"; color=black;
u1 [shape=ellipse,label="UC01 — Đăng ký tài khoản"];
u2 [shape=ellipse,label="UC02 — Đăng nhập"];
u3 [shape=ellipse,label="UC03 — Đăng xuất"];
}
a -- u1;
a -- u2;
a -- u3;
}