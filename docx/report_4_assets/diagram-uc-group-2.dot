graph G { rankdir=LR; bgcolor=white;
node [fontname="DejaVu Sans",fontsize=12,fontcolor=black,color=black];
edge [color=black];
a [shape=plaintext,label="Khách vãng lai / người dùng"];
subgraph cluster_system { label="StayHub"; color=black;
u4 [shape=ellipse,label="UC04 — Tìm kiếm chỗ ở"];
u5 [shape=ellipse,label="UC05 — Lọc và sắp xếp kết quả"];
u6 [shape=ellipse,label="UC06 — Xem chi tiết chỗ ở"];
u7 [shape=ellipse,label="UC07 — Kiểm tra tình trạng trống"];
}
a -- u4;
a -- u5;
a -- u6;
a -- u7;
}